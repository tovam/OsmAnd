+    bool hasRegionalCartography(const std::shared_ptr<OsmAnd::MapPrimitivesProvider::Data>& tile)
+    {
+        if (!tile || !tile->mapObjectsData)
+            return false;
+        for (const auto& object : tile->mapObjectsData->mapObjects)
+        {
+            const auto binary = std::dynamic_pointer_cast<const OsmAnd::BinaryMapObject>(object);
+            // World coastlines, routing-only and contour overlays do not replace a country map.
+            if (binary && !binary->section->isBasemap && !binary->section->isContourLines && !binary->isCoastline)
+                return true;
+        }
+        return false;
+    }
