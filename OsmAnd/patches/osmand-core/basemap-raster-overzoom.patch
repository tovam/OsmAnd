+bool OsmAnd::MapRasterLayerProvider_P::rasterizeBasemapParent(
+    const MapRasterLayerProvider::Request& request, sk_sp<SkImage>& image)
+{
+    image.reset();
+    const auto firstZoom = static_cast<ZoomLevel>(std::min(
+        static_cast<int>(request.zoom) - 1, static_cast<int>(MapPrimitiviser::LastZoomToUseBasemap)));
+    const auto firstDelta = static_cast<unsigned>(request.zoom - firstZoom);
+    const auto firstTile = TileId::fromXY(request.tileId.x >> firstDelta, request.tileId.y >> firstDelta);
+
+    auto sourceZoom = firstZoom;
+    sk_sp<SkImage> parentImage;
+    bool cached = false;
+    {
+        QMutexLocker locker(&_basemapRasterMutex);
+        for (auto it = _basemapRasters.begin(); it != _basemapRasters.end(); ++it)
+        {
+            if (it->zoom == firstZoom && it->tileId.x == firstTile.x && it->tileId.y == firstTile.y)
+            {
+                cached = true;
+                sourceZoom = it->sourceZoom;
+                parentImage = it->image;
+                _basemapRasters.splice(_basemapRasters.begin(), _basemapRasters, it);
+                break;
+            }
+        }
+    }
+    if (!cached)
+    {
+        std::shared_ptr<MapPrimitivesProvider::Data> parentPrimitives;
+        // A world file/style need not supply usable cartography at z11. Walk the
+        // actual parents, rather than enlarging z11's generated blank background.
+        for (int z = firstZoom; z >= MinZoomLevel; --z)
+        {
+            if (request.queryController->isAborted())
+                return false;
+            sourceZoom = static_cast<ZoomLevel>(z);
+            const auto delta = static_cast<unsigned>(request.zoom - sourceZoom);
+            MapRasterLayerProvider::Request parentRequest;
+            // Tiled Request::copy omits the base fields, including queryController.
+            // The primitives provider dereferences that controller immediately.
+            IMapDataProvider::Request::copy(parentRequest, request);
+            MapRasterLayerProvider::Request::copy(parentRequest, request);
+            parentRequest.zoom = sourceZoom;
+            parentRequest.detailedZoom = sourceZoom;
+            parentRequest.tileId = TileId::fromXY(request.tileId.x >> delta, request.tileId.y >> delta);
+            parentRequest.visibleArea31 = Utilities::tileBoundingBox31(parentRequest.tileId, sourceZoom);
+            parentPrimitives.reset();
+            if (!owner->primitivesProvider->obtainTiledPrimitives(parentRequest, parentPrimitives, nullptr)
+                || request.queryController->isAborted())
+                return false; // Do not cache a cancelled/failed lookup as missing data.
+            if (!hasRasterCartography(parentPrimitives, parentRequest))
+                continue;
+            parentImage = rasterize(parentRequest, parentPrimitives, nullptr);
+            if (!parentImage || request.queryController->isAborted())
+                return false;
+            break;
+        }
+        if (!parentImage)
+            parentPrimitives.reset();
+        QMutexLocker locker(&_basemapRasterMutex);
+        // Cache the selected source level (including a completely missing map),
+        // so sibling children do not re-scan every unavailable zoom. Provider
+        // recreation on map/style changes also invalidates this bounded cache.
+        _basemapRasters.remove_if([&](const BasemapRaster& entry) {
+            return entry.zoom == firstZoom && entry.tileId.x == firstTile.x && entry.tileId.y == firstTile.y;
+        });
+        _basemapRasters.push_front({firstTile, firstZoom, sourceZoom, parentPrimitives, parentImage});
+        while (_basemapRasters.size() > 4)
+            _basemapRasters.pop_back();
+    }
+    if (request.queryController->isAborted())
+        return false;
+    if (!parentImage)
+        return true;
+
+    const auto size = owner->getTileSize();
+    SkPixmap source;
+    SkBitmap target;
+    if (!parentImage->peekPixels(&source) || source.colorType() != kN32_SkColorType
+        || source.width() != static_cast<int>(size) || source.height() != static_cast<int>(size)
+        || !target.tryAllocPixels(SkImageInfo::MakeN32Premul(size, size)))
+        return false;
+    const auto delta = static_cast<unsigned>(request.zoom - sourceZoom);
+    if (!BasemapOverzoom::magnifyParent(request.tileId.x, request.tileId.y, delta, size,
+        [&](unsigned x, unsigned y) { return *source.addr32(x, y); },
+        [&](unsigned x, unsigned y, std::uint32_t color) { *target.getAddr32(x, y) = color; },
+        [&]() { return request.queryController->isAborted(); }))
+        return false;
+    target.setImmutable();
+    image = target.asImage();
+    return image != nullptr;
+}
