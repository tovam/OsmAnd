+    bool hasRegionalCartography(const std::shared_ptr<OsmAnd::MapPrimitivesProvider::Data>& tile,
+        const OsmAnd::MapRasterLayerProvider::Request& request)
+    {
+        if (!tile || !tile->primitivisedObjects)
+            return false;
+        const auto area = OsmAnd::Utilities::tileBoundingBox31(request.tileId, request.zoom);
+        const auto& rendered = *tile->primitivisedObjects;
+        // The OBF reader deliberately enlarges its read area. Raw objects can be
+        // outside this tile, or removed by the style. Neither proves coverage here.
+        for (const auto* collection : {&rendered.polygons, &rendered.polylines, &rendered.points})
+        {
+            for (const auto& primitive : *collection)
+            {
+                const auto binary = std::dynamic_pointer_cast<const OsmAnd::BinaryMapObject>(primitive->sourceObject);
+                // World coastlines, routing-only and contours are not a country map.
+                if (binary && !binary->section->isBasemap && !binary->section->isContourLines
+                    && !binary->isCoastline
+                    && binary->intersectedOrContainedBy(area, area, request.areaTime))
+                    return true;
+            }
+        }
+        return false;
+    }
+
+    bool hasRasterCartography(const std::shared_ptr<OsmAnd::MapPrimitivesProvider::Data>& tile,
+        const OsmAnd::MapRasterLayerProvider::Request& request)
+    {
+        if (!tile || !tile->primitivisedObjects)
+            return false;
+        const auto area = OsmAnd::Utilities::tileBoundingBox31(request.tileId, request.zoom);
+        const auto& rendered = *tile->primitivisedObjects;
+        // isEmpty() also counts symbol-only groups and the automatically generated
+        // land background. They can produce a completely blank raster: keep looking.
+        for (const auto* collection : {&rendered.polygons, &rendered.polylines})
+        {
+            for (const auto& primitive : *collection)
+            {
+                const auto& object = primitive->sourceObject;
+                if (object && !std::dynamic_pointer_cast<const OsmAnd::MapPrimitiviser::SurfaceMapObject>(object)
+                    && object->intersectedOrContainedBy(area, area, request.areaTime))
+                    return true;
+            }
+        }
+        return false;
+    }
+}

